    ["emma j", "emma johnson", 0.9],
    ["emma j", "emma", 0.9333333333333333],
    ["emny", "emmy", 0.8666666666666667],
    ["emny", "emma", 0.6666666666666666],
    ["olivia chen", "olivia", 0.9090909090909091],
    ["martha", "marhta", 0.9611111111111111],
    ["crate", "trace", 0.7333333333333334],
    ["ab", "ba", 0.0],
    ["dwayne", "duane", 0.8400000000000001],
    ["zed", "emma", 0.5277777777777778],
    ["emma j", "emma garcia", 0.8575757575757577],
    ["emma", "emma", 1.0]
  ],
  "tiers": [
    {
      "first": "Emma",
      "last": "Johnson",
      "nametag": "Emmy",
