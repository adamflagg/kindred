      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "similar",
        "filing": 0
      }
    },
    {
      "name": "one filer's two filings are one similar match",
      "typed": "Emny",
      "filings": ["emma", "emma", "olivia"],
      "expect": {
        "kind": "similar",
        "filing": 0
      }
    },
    {
      "name": "a similar name two filers tie on picks nothing",
      "typed": "Emma J",
      "filings": ["emma", "emma_garcia"],
      "expect": {
        "kind": "none"
      }
    },
    {
      "name": "nothing close enough",
      "typed": "Zed",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "none"
      }
    },
    {
      "name": "nothing typed",
      "typed": "   ",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "none"
      }
    }
  ],
