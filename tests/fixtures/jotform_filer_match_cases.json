      "tiers": [[], [], [], ["zoe"]]
    }
  ],
  "match": [
    {
      "name": "first and last name",
      "typed": "Emma Johnson",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "exact",
        "filing": 0
      }
    },
    {
      "name": "the whole nametag",
      "typed": "Emmy",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "exact",
        "filing": 0
      }
    },
    {
      "name": "nametag and last name",
      "typed": "emmy johnson",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "exact",
        "filing": 0
      }
    },
    {
      "name": "a first name alone, when only one filer has it",
      "typed": "Olivia",
      "filings": ["emma", "olivia"],
      "expect": {
        "kind": "exact",
        "filing": 1
      }
    },
    {
      "name": "a first name two filers share picks nothing",
      "typed": "Emma",
      "filings": ["emma", "emma_garcia"],
      "expect": {
        "kind": "none"
      }
    },
    {
      "name": "a better tier decides before a worse one is ambiguous",
      "typed": "Em",
      "filings": ["emma_em", "em_garcia"],
      "expect": {
        "kind": "exact",
        "filing": 0
      }
    },
    {
      "name": "one filer's two filings are one match",
