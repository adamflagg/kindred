[
  {"name": "admin previewing a role", "auth": "user", "real_is_admin": true, "real_permissions": [],
   "header": "registration.manage,metrics.geo",
   "want": {"applied": true, "is_admin": false, "permissions": ["metrics.geo", "registration.manage"]}},
  {"name": "admin previewing no role via sentinel", "auth": "user", "real_is_admin": true, "real_permissions": ["sheets.export"],
   "header": "none",
   "want": {"applied": true, "is_admin": false, "permissions": []}},
  {"name": "whitespace blanks and duplicates are normalised", "auth": "user", "real_is_admin": true, "real_permissions": [],
   "header": " bunking.manage, ,bunking.manage ,sheets.export,,",
   "want": {"applied": true, "is_admin": false, "permissions": ["bunking.manage", "sheets.export"]}},
  {"name": "unknown codenames pass through because there is no allow-list", "auth": "user", "real_is_admin": true, "real_permissions": [],
   "header": "not.a.permission",
   "want": {"applied": true, "is_admin": false, "permissions": ["not.a.permission"]}},
  {"name": "absent header leaves admin untouched", "auth": "user", "real_is_admin": true, "real_permissions": ["sheets.export"],
   "header": null,
   "want": {"applied": false, "is_admin": true, "permissions": ["sheets.export"]}},
  {"name": "blank header counts as absent", "auth": "user", "real_is_admin": true, "real_permissions": [],
   "header": "   ",
   "want": {"applied": false, "is_admin": true, "permissions": []}},
  {"name": "non-admin header cannot escalate", "auth": "user", "real_is_admin": false, "real_permissions": [],
   "header": "users.manage",
   "want": {"applied": false, "is_admin": false, "permissions": []}},
  {"name": "non-admin header cannot self-downgrade", "auth": "user", "real_is_admin": false, "real_permissions": ["bunking.manage"],
   "header": "none",
   "want": {"applied": false, "is_admin": false, "permissions": ["bunking.manage"]}},
  {"name": "superuser is ignored", "auth": "superuser", "real_is_admin": false, "real_permissions": [],
   "header": "none",
   "want": {"applied": false, "is_admin": false, "permissions": []}},
  {"name": "no auth is ignored", "auth": "none", "real_is_admin": false, "real_permissions": [],
   "header": "bunking.manage",
   "want": {"applied": false, "is_admin": false, "permissions": []}}
]
