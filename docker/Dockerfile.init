# =============================================================================
# Stage 1: Build PocketBase binary (needed for superuser upsert)
# =============================================================================
FROM golang:1.27-alpine AS go-builder

# Rule: pocketbase/go.mod picks the minor; every build uses the latest patch of
# it. The floating golang:X.Y-alpine tag IS that latest patch, so the image tag
# is the toolchain and nothing may download another one. GOTOOLCHAIN=auto did
# exactly that -- and it fetched the MINIMUM version go.mod allows (go1.27.0),
# not the latest patch. `local` is already the golang image's default; it is
# spelled out so no one "fixes" it back. scripts/ci/check-go-version-alignment.sh
# enforces all of this.
#
# No git: `go mod download` fetches every dependency from proxy.golang.org as
# a zip, and .git is dockerignored so `go build` has no VCS to stamp.
ENV GOTOOLCHAIN=local

WORKDIR /build
COPY pocketbase/go.mod pocketbase/go.sum ./
RUN go mod download
COPY pocketbase/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o pocketbase .

# =============================================================================
# Stage 2: Init runtime (needs shell + curl for OIDC discovery)
# =============================================================================
FROM chainguard/wolfi-base:latest

# hadolint ignore=DL3018
RUN apk add --no-cache curl

COPY --link --from=go-builder /build/pocketbase /usr/local/bin/pocketbase
COPY --link --chmod=755 docker/init-entrypoint.sh /init-entrypoint.sh

USER nonroot

ENV TZ=UTC

ENTRYPOINT ["/init-entrypoint.sh"]
