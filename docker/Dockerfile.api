# =============================================================================
# Stage 1: Python dependencies build
# =============================================================================
FROM chainguard/wolfi-base:latest AS python-builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# hadolint ignore=DL3018
RUN apk add --no-cache python-3.14 python-3.14-dev build-base

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM chainguard/wolfi-base:latest

# hadolint ignore=DL3018
RUN apk add --no-cache python-3.14 libstdc++ curl \
    && mkdir -p /app/logs \
    && chown -R nonroot:nonroot /app

WORKDIR /app

COPY --link --from=python-builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# Application source.
#
# kindred#2575: config/ is copied BY NAME, not by directory. Copying the whole
# directory meant this image shipped every private file that happened to be in
# the build context -- the lodging registry (which has no Python reader at all;
# the Go binary gets it from the /config volume at runtime) and, on a local
# `docker build`, the gitignored Google service-account key. Only branding,
# the staff list, the nickname overrides and the AI prompts are read here:
# bunking/branding.py, staff_name_detector.py, nickname_groups.py, and the two
# prompt loaders (bunking/.../prompts/loader.py, api/routers/debug.py).
#
# Each glob below is anchored on a COMMITTED file -- branding.json,
# staff_list.example.json, nicknames_override.example.json -- so it always
# matches something. That matters because the private files are optional:
# scripts/build/docker-build.sh deletes their symlinks when kindred-local is
# absent, and a COPY whose glob matches nothing fails the build outright.
COPY --link --chown=65532:65532 config/prompts/ ./config/prompts/
COPY --link --chown=65532:65532 \
     config/branding*.json \
     config/staff_list*.json \
     config/nicknames_override*.json \
     ./config/
COPY --link --chown=65532:65532 campminder/ ./campminder/
COPY --link --chown=65532:65532 api/ ./api/
COPY --link --chown=65532:65532 bunking/ ./bunking/

# Git SHA injection — passed as a build arg from CI / local builds and surfaced
# at runtime so the run-tagging module (bunking/solver/run_tagging.py) can stamp
# every solver_runs row with the exact commit it ran on.
ARG GIT_SHA=unknown
ENV KINDRED_GIT_SHA=${GIT_SHA}

USER nonroot

EXPOSE 8000

ENV HOME=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV POCKETBASE_URL=http://pocketbase:8090
ENV LOG_LEVEL=INFO
ENV TZ=UTC

HEALTHCHECK --interval=15s --timeout=10s --retries=5 --start-period=45s \
    CMD curl --connect-timeout 2 --max-time 5 -f http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["/app/.venv/bin/python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
