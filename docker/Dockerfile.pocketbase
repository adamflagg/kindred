# =============================================================================
# Stage 1: Build PocketBase (pure Go, no CGO)
# =============================================================================
FROM dhi.io/golang:1.26-dev AS go-builder

# Allow Go to auto-download the toolchain pinned in go.mod when the base image
# ships an older patch version (dhi.io golang tags lag upstream by a few patches).
ENV GOTOOLCHAIN=auto

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY pocketbase/go.mod pocketbase/go.sum ./
RUN go mod download
COPY pocketbase/ ./

# CGO_ENABLED=0: uses modernc.org/sqlite (pure Go SQLite, already in go.mod)
# Produces a fully static binary that runs on chainguard/static
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o pocketbase .

# =============================================================================
# Stage 2: Build healthcheck binary
# =============================================================================
FROM golang:1.26.4-alpine AS healthcheck-builder

WORKDIR /build
COPY docker/healthcheck/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o healthcheck .

# =============================================================================
# Stage 3: Create directory structure (distroless has no mkdir)
# =============================================================================
FROM busybox:latest AS dirs

RUN mkdir -p /pb_data && chown 65532:65532 /pb_data

# =============================================================================
# Stage 4: Distroless runtime
# =============================================================================
FROM chainguard/static:latest

# /pb_data owned by nonroot — Docker named volumes inherit this ownership
COPY --link --from=dirs /pb_data /pb_data
COPY --link --from=go-builder /build/pocketbase /usr/local/bin/pocketbase
COPY --link --from=healthcheck-builder /build/healthcheck /usr/local/bin/healthcheck
COPY --link pocketbase/pb_hooks /pb_hooks
COPY --link pocketbase/pb_migrations /pb_migrations

VOLUME /pb_data

USER nonroot

EXPOSE 8090

ENV HOME=/app
ENV TZ=UTC

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
    CMD ["/usr/local/bin/healthcheck", "http://127.0.0.1:8090/api/health"]

ENTRYPOINT ["/usr/local/bin/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb_data", "--publicDir=/dev/null", "--hooksDir=/pb_hooks", "--migrationsDir=/pb_migrations"]
