# Production Caddyfile for multi-container deployment.
# Sits behind an upstream reverse proxy that terminates TLS and forwards over
# the local Docker network. Treat every request as unauthenticated:
# PocketBase's collection rules and Go hooks are the only auth on
# /api/collections/*.
#
# Routes to upstream services via env vars (with defaults for compose service names):
#   POCKETBASE_HOST (default: pocketbase) → port 8090
#   API_HOST (default: api) → port 8000
#
# Transport-layer concerns kept here (the rest belongs to the upstream proxy):
#   - trusted_proxies private_ranges  → real client IP from X-Forwarded-For
#   - security_headers snippet        → defense-in-depth; harmless if the proxy also sets them
#   - cors snippet                    → app-layer; lives near the API/PB split
#   - no_store snippet + static route → Cache-Control on every response
#
# Note on logging:
# - Console format: TIMESTAMP LEVEL LOGGER MESSAGE (Caddy's fixed format)
# - Project standard: TIMESTAMP [source] LEVEL message (Python/Go format)
# - Startup JSON logs from automaxprocs/automemlimit are unavoidable (run before config loads)
# - TZ=UTC in Dockerfile ensures UTC timestamps
{
	admin off

	# The upstream proxy is the immediate peer on the local Docker network.
	# Trust private ranges so {client_ip} and logs reflect the real origin IP,
	# not the proxy peer. This assumes only trusted proxies can reach this
	# container. Required for the IP gates below (/_/ and the superuser API)
	# that key on {client_ip}.
	#
	# The first header is read FIRST because the edge in front of production
	# sets it itself and discards any client-supplied value, so it cannot be
	# forged. X-Forwarded-For can: Caddy takes its left-most entry, so a client
	# that prepends an allowlisted address would pass the gates. XFF remains the
	# fallback for paths where the first header is absent (dev). Do NOT switch on trusted_proxies_strict instead: it reads XFF
	# right-to-left and resolves an admin on a private-range address to the
	# proxy's own IP, locking them out of /_/.
	# scripts/ci/probe-caddy-superuser-gate.sh pins all of this.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}

	log {
		format console {
			time_format iso8601
		}
		level INFO
	}
}

# Secure-headers middleware equivalent. X-XSS-Protection is omitted
# on purpose — modern browsers ignore the legacy header. Server response
# header is stripped so we don't leak the upstream identity.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "accelerometer=(),camera=(),geolocation=(self),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()"
		X-Robots-Tag "none,noarchive,nosnippet,notranslate,noimageindex"
		-Server
	}
}

# CORS layer on top of whatever the upstream sets. Matches the request Origin
# against ALLOWED_ORIGINS_REGEX (pipe-separated, regex-escaped). Empty env
# var = no origin matches = CORS effectively off in Caddy. FastAPI continues
# to read ALLOWED_ORIGINS independently for its own CORS needs.
(cors) {
	@cors_origin header_regexp Origin ^(?i)({$ALLOWED_ORIGINS_REGEX})$
	header @cors_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Credentials "true"
		Vary "Origin"
	}
}

# Cache-Control for everything that is not a static file: every API,
# PocketBase and health response, including the 403s Caddy answers itself.
# Defence in depth against any shared cache between Caddy and the browser.
# `>` defers the header to response time, so it REPLACES whatever the upstream
# sent rather than sitting beside it -- PocketBase marks /api/files/* and its
# admin UI's assets cacheable for weeks -- and still covers `respond` and
# handle_response replies. Every handle below except the static one imports
# this; scripts/ci/probe-caddy-cache-headers.sh checks each route.
(no_store) {
	header >Cache-Control no-store
}

:8080 {
	import security_headers
	import cors

	# Compression and rate-limiting belong to the upstream proxy. Adding them
	# here would double-count rate-limit buckets and duplicate its compression
	# for no gain.
	#
	# #1966 read the absence of `encode` here as an oversight. It is not — but
	# note the dev path has no proxy in front of it, which is why the API
	# compresses its own large JSON (`GZipMiddleware`, api/main.py) and why
	# frontend/Caddyfile DOES carry `encode`. The proxy passes an
	# already-encoded response through rather than recompressing it.

	# PocketBase-specific patterns (explicit)
	# These /api/* routes go to PocketBase (port 8090)
	# Note: Must include both root paths and wildcards (e.g., /api/collections AND /api/collections/*)
	@pocketbase path /api/collections /api/collections/* /api/files/* /api/realtime /api/custom/* /api/settings /api/logs /api/logs/* /api/backups /api/backups/* /api/batch

	# PocketBase routes (database, auth, sync, file uploads)
	handle @pocketbase {
		import no_store
		# The superuser collection's API -- password login, OTP, record CRUD --
		# is IP-gated like /_/ below. Both spellings, because PocketBase
		# resolves {collection} by name OR id and folds its case (Unicode, not
		# just ASCII -- see the matcher below). A literal path-prefix rule is not
		# enough: `_SUPERUSERS` and the id walk past one.
		# scripts/ci/probe-caddy-superuser-gate.sh checks every spelling.
		# Internal superuser logins (kindred-api, sync, scripts on the host) go
		# straight to pocketbase:8090 and never pass through here.
		@superuser_api_blocked {
			# A regexp, not a `path` list, on purpose. PocketBase resolves the
			# collection with strings.EqualFold: Unicode case folding, so
			# `_%C5%BFuperusers` (U+017F long s) reaches `_superusers`. The
			# `path` matcher only lowercases, so that spelling walked past it.
			# Go's (?i) applies the same Unicode simple folding as EqualFold.
			path_regexp superuser_api (?i)^/api/collections/(_superusers|pbc_3142635823)(/|$)
			not client_ip {$ADMIN_ALLOWLIST}
		}
		respond @superuser_api_blocked 403
		reverse_proxy {$POCKETBASE_HOST:pocketbase}:8090 {
			header_up Host {host}
			# The real client address for PocketBase's RealIP() (admin audit log,
			# logs, rate limits): {client_ip} is the same resolution the IP gates
			# above use, and header_up replaces any X-Real-IP the client sent.
			# pb_migrations/1500000207 trusts exactly this header.
			header_up X-Real-IP {client_ip}
		}
	}

	# OAuth2 redirect handler — separate from @pocketbase so we can rewrite
	# the upstream's Location header. PocketBase issues a 307 to
	# /_/#/auth/oauth2-redirect-{success,failure}, which would force /_/ to
	# stay public. We rewrite to /oauth2-complete (kindred-served static page)
	# so /_/ can be IP-gated below.
	#
	# The realtime @oauth2 message carrying {state, code} is sent server-side
	# *before* PB issues the redirect (record_auth_with_oauth2_redirect.go),
	# so the parent window receives the auth result regardless of where the
	# popup follows the Location header.
	handle /api/oauth2-redirect {
		import no_store
		reverse_proxy {$POCKETBASE_HOST:pocketbase}:8090 {
			header_up Host {host}
			# See the @pocketbase block above: the same real-client-address header.
			header_up X-Real-IP {client_ip}
			# Caddyfile gotcha: `redir /path 307` parses /path as a matcher
			# (path-shortcut) and 307 as the redirect target. Use explicit
			# header + respond to issue the rewrite unambiguously.
			@oauth_success header Location *oauth2-redirect-success*
			handle_response @oauth_success {
				header Location "/oauth2-complete.html?status=success"
				respond 307
			}
			@oauth_failure header Location *oauth2-redirect-failure*
			handle_response @oauth_failure {
				header Location "/oauth2-complete.html?status=failure"
				respond 307
			}
		}
	}

	# PocketBase admin UI — IP-gated by ADMIN_ALLOWLIST (space-separated CIDRs).
	# REQUIRED: must be set in .env. No default — Caddy fails to start if unset
	# so a quoting mistake or missing var can't silently disable the gate. Use
	# "0.0.0.0/0 ::/0" to explicitly opt into "open to all" if that's the intent.
	# With OAuth's redirect rewritten above, gating /_/* does NOT break user login —
	# the popup never lands at /_/ anymore; only superuser admin access does.
	# Use client_ip (not remote_ip) so we match the real origin behind any
	# trusted proxy. client_ip resolves via the
	# trusted_proxies + client_ip_headers config in the global server block.
	# (remote_ip would be the Docker bridge IP of whichever proxy handed off,
	# which is the same for every real user — gate would fail open or closed.)
	handle /_/* {
		import no_store
		@admin_blocked not client_ip {$ADMIN_ALLOWLIST}
		respond @admin_blocked 403
		reverse_proxy {$POCKETBASE_HOST:pocketbase}:8090 {
			header_up Host {host}
			# See the @pocketbase block above: the same real-client-address header.
			header_up X-Real-IP {client_ip}
		}
	}

	# Health check (standard path for load balancers)
	handle /health {
		import no_store
		reverse_proxy {$API_HOST:api}:8000
	}

	# Block external access to internal service-to-service endpoints
	handle /api/internal/* {
		import no_store
		respond 403
	}

	# FastAPI catch-all for /api/* (solver, scenarios, validation, social-graph, config, etc.)
	handle /api/* {
		import no_store
		reverse_proxy {$API_HOST:api}:8000
	}

	# Frontend static files (served directly by Caddy)
	handle {
		root * /pb_public

		# Vite's build output: every file under /assets/ carries a content hash
		# in its name, so a URL's bytes never change. `file` means it exists on
		# disk -- a missing bundle falls back to index.html below and must not
		# take this policy.
		@hashed_asset {
			path /assets/*
			file
		}
		# Any other real file that is not an HTML document: frontend/public's
		# icons and the /local/ branding. Their names do not change when their
		# bytes do, so a cache may keep them but must revalidate on every use
		# (a cheap 304 against the ETag file_server sends).
		@unhashed_static {
			file
			not path /assets/* *.html
		}

		# `route` keeps this order: the default first, then the narrower
		# matches overwrite it. Whatever falls through -- index.html, the SPA
		# fallback for every unknown path, oauth2-complete.html -- is an HTML
		# document and is never stored.
		route {
			header Cache-Control no-store
			header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
			header @unhashed_static Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
