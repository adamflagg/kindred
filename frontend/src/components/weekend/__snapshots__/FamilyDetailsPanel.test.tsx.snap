// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FamilyDetailsPanel — pixel identity without a note slot (board notes) > renders exactly what main renders 1`] = `"<div><div data-testid="family-panel-backdrop" class="pointer-events-none fixed inset-0 z-[59]" aria-hidden="true"></div><div data-panel="family-details" data-testid="family-details-panel" role="dialog" aria-label="The Johnson Family details" class="bg-card shadow-lodge-xl border-border fixed top-0 right-0 bottom-0 z-[60] flex w-[26rem] max-w-full flex-col border-l animate-slide-in-right"><div class="from-forest-700 via-forest-800 to-forest-900 flex flex-shrink-0 items-start gap-3 bg-gradient-to-br p-4 text-white"><div class="min-w-0 flex-1"><h2 class="truncate text-lg font-bold">The Johnson Family</h2><p class="text-forest-100 mt-0.5 text-xs">Household</p></div><button type="button" aria-label="Close panel" class="-mr-1 rounded-lg p-1.5 transition-colors hover:bg-white/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-4 w-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="flex-1 overflow-y-auto"><div class="flex flex-col gap-4 p-4"><section class="flex flex-col gap-1.5"><h3 class="text-muted-foreground text-[11px] font-bold tracking-wider uppercase">Placement</h3><div class="flex flex-wrap items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house lucide-home text-muted-foreground h-4 w-4 flex-shrink-0" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg><span class="text-foreground text-sm font-medium">Cedar 1</span><span class="text-muted-foreground text-xs">Cedar Grove</span></div><p class="text-muted-foreground flex flex-wrap items-baseline gap-1.5 text-xs"><span class="font-medium">Cabin doesn't fit the request</span><span>No power</span></p></section><section class="flex flex-col gap-1.5"><h3 class="text-muted-foreground text-[11px] font-bold tracking-wider uppercase">Party</h3><div class="text-muted-foreground flex flex-wrap items-center gap-3 text-xs"><span class="inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-3.5 w-3.5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>3 people</span><span class="inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>Friday 6pm</span><span class="text-forest-700 dark:text-forest-300 inline-flex items-center gap-1 font-semibold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat h-3.5 w-3.5" aria-hidden="true"><path d="m17 2 4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path d="m7 22-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg>Returning</span></div><ul data-testid="family-panel-adults" class="flex flex-col gap-0.5"><li class="flex flex-wrap items-baseline gap-2 text-sm"><span class="text-foreground">Emma Johnson</span><span class="text-muted-foreground text-xs">Mother</span></li><li class="flex flex-wrap items-baseline gap-2 text-sm"><span class="text-foreground">David Johnson</span><span class="text-muted-foreground text-xs">Father</span></li></ul><ul class="flex flex-col gap-0.5"><li class="flex flex-wrap items-baseline gap-2 text-sm"><span class="text-foreground">Noah Johnson</span><span class="text-muted-foreground text-xs">Age 8.00</span></li></ul></section><section class="flex flex-col gap-1.5"><h3 class="text-muted-foreground text-[11px] font-bold tracking-wider uppercase">Share request</h3><div class="flex flex-col gap-1.5"><ul class="flex flex-col gap-2"><li class="flex flex-col gap-[3px]"><div class="flex items-center gap-1.5 text-[13.5px]"><span data-testid="share-anchor" class="inline-flex h-[22px] w-[22px] flex-shrink-0 items-center justify-center bg-forest-100 text-forest-800 dark:bg-forest-950/50 dark:text-forest-300 rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-handshake h-[13px] w-[13px]" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"></path><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"></path><path d="m21 3 1 11h-2"></path><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"></path><path d="M3 4h8"></path></svg></span><span class="ml-0.5 font-semibold">Yes, Share Cabin</span></div></li><li><p data-testid="request-entry" class="text-foreground pl-[30px] text-[13px] italic whitespace-pre-wrap break-words opacity-[.85]">We would like to be near the Garcia family if there is room.</p></li></ul></div></section><section class="flex flex-col gap-1.5"><h3 class="text-muted-foreground text-[11px] font-bold tracking-wider uppercase">Housing needs</h3><ul class="flex flex-col gap-2.5"><li data-testid="need-row-power" class="flex flex-col gap-1"><div class="flex items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug h-4 w-4 flex-shrink-0 text-purple-500 dark:text-purple-400" aria-hidden="true"><path d="M12 22v-5"></path><path d="M15 8V2"></path><path d="M17 8a1 1 0 0 1 1 1v4a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1z"></path><path d="M9 8V2"></path></svg><span class="text-foreground font-semibold">Power</span></div></li></ul></section><div data-testid="household-journey" class="bg-card border-border overflow-hidden rounded-2xl border shadow-sm"><div class="from-forest-600 to-forest-700 bg-gradient-to-r px-5 py-4"><h2 data-testid="household-journey-title" class="font-display flex items-center gap-2 text-lg font-bold text-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tree-pine h-5 w-5 flex-shrink-0" aria-hidden="true"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"></path><path d="M12 22v-3"></path></svg>Family Camp history</h2></div><div class="p-5"><div class="text-muted-foreground flex items-center justify-center py-12">No family camp history on file</div></div></div></div></div></div></div>"`;
