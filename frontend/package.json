{
  "name": "kindred-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:default": "vite",
    "build": "tsc && vite build && node scripts/fix-css-infinity.js",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 206",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --reporter=tree --coverage",
    "generate-types": "node scripts/generate-types.js",
    "generate:api-types": "node scripts/generate-api-types.js",
    "generate:all-types": "npm run generate-types && npm run generate:api-types"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@popperjs/core": "^2.11.8",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.3",
    "cytoscape-bubblesets": "^4.0.0",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-layers": "^3.1.0",
    "cytoscape-popper": "^4.0.1",
    "cytoscape-svg": "^0.4.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.8.0",
    "gsap": "3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "pocketbase": "^0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "zod": "^4.6.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "flatted": "^3.4.4",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.28",
    "undici": "^8.10.2",
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.0.0"
    },
    "nanoid": "^3.3.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "pdf-parse": "^2.4.5",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-is": "^19.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
