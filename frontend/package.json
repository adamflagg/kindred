{
  "name": "kindred-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:default": "vite",
    "build": "tsc && vite build && node scripts/fix-css-infinity.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --reporter=tree --coverage",
    "generate-types": "node scripts/generate-types.js",
    "generate:api-types": "node scripts/generate-api-types.js",
    "generate:all-types": "npm run generate-types && npm run generate:api-types"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@popperjs/core": "^2.11.8",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.33.4",
    "cytoscape-bubblesets": "^4.0.0",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-layers": "^3.1.0",
    "cytoscape-popper": "^4.0.1",
    "cytoscape-svg": "^0.4.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "pocketbase": "^0.27.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.2.0",
    "recharts": "^3.9.1",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "zod": "^4.4.1"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "^10.0.0"
    },
    "flatted": ">=3.4.2",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-is": "^19.2.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
